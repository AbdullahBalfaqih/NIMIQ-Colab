# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://nimiq_user:nimiq_pass@localhost:5432/nimiq_db?schema=public"

# ─── JWT (RS256) ─────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.key 2048
#   openssl rsa -in private.key -pubout -out public.key
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_YOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_to_a_long_random_secret_min_64_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Nimiq ───────────────────────────────────────────────────
NIMIQ_NETWORK=testnet
# Testnet:  wss://rpc-testnet.nimiq.network
# Mainnet:  wss://rpc.nimiq.network
NIMIQ_RPC_URL=wss://rpc-testnet.nimiq.network
# Minimum confirmations before accepting a tx
NIMIQ_MIN_CONFIRMATIONS=2

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX=5
RATE_LIMIT_PAYMENT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# ─── Idempotency ─────────────────────────────────────────────
IDEMPOTENCY_KEY_TTL_HOURS=24
